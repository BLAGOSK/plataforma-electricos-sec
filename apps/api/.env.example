# ─────────────────────────────────────────────────────────────
# API — Plataforma Eléctricos SEC
# Copia este archivo a apps/api/.env. Valores de ejemplo para desarrollo local:
# NUNCA uses estos secretos en producción.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose.yml expone el puerto 5432)
DATABASE_URL=postgresql://electricos:electricos_dev@localhost:5432/electricos?schema=public

# Origen del frontend (CORS y enlaces de los correos)
WEB_URL=http://localhost:5173

# JWT de acceso: genera uno con `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=cambia-este-secreto-de-desarrollo-por-uno-aleatorio-de-48-bytes
JWT_ACCESS_TTL_SEG=900
REFRESH_TTL_DIAS=7
# true en producción (requiere HTTPS)
COOKIE_SECURE=false

# Almacenamiento S3 (MinIO en local). Para AWS S3 deja S3_ENDPOINT vacío y S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
# Endpoint que usará el navegador en las URLs prefirmadas (si difiere del interno)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=electricos-sec
S3_ACCESS_KEY=electricos
S3_SECRET_KEY=electricos_minio_dev
S3_FORCE_PATH_STYLE=true
S3_CREAR_BUCKET=true
PRESIGN_TTL_SEG=300
MAX_UPLOAD_MB=50

# Correo (Mailpit en desarrollo: bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Plataforma Eléctricos SEC <no-responder@electricos-sec.local>

# ── Seed ──────────────────────────────────────────────────────
# Administrador inicial (obligatorio). Contraseña: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
SEED_ADMIN_NOMBRE=Administrador Plataforma
SEED_ADMIN_RUT=11.111.111-1
SEED_ADMIN_EMAIL=admin@demo.cl
SEED_ADMIN_PASSWORD=
# Datos de demostración (usuarios, proyectos, revisiones). Desactívalos en producción.
SEED_DEMO=true
SEED_DEMO_PASSWORD=
